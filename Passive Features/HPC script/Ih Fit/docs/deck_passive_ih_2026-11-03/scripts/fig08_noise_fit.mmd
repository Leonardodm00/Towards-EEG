%%{init: {"theme": "base", "fontFamily": "Inter, DejaVu Sans, Arial, sans-serif", "themeVariables": {"fontSize": "17px", "fontFamily": "Inter, DejaVu Sans, Arial, sans-serif", "lineColor": "#52514e", "primaryTextColor": "#0b0b0b", "clusterBkg": "#fafaf8", "clusterBorder": "#c9c8c3", "edgeLabelBackground": "#ffffff"}, "flowchart": {"curve": "basis", "nodeSpacing": 28, "rankSpacing": 46, "htmlLabels": true, "wrappingWidth": 360}}}%%
flowchart TB
  subgraph CELL["Per-cell fit of the law (Blocks 1-4: pushed)"]
    direction LR
    W1["SS: 37-pulse trains, kept windows;<br/>each window's tilt offset removed;<br/>median window per sweep and polarity<br/>subtracted from t_SS(c)<br/>(exact decay fit, 80 ms floor)"]:::neutral
    W2["LS: 265 ms pre-window of every sweep;<br/>its tilt from the pre- and end-window means"]:::neutral
    Q["q_hat(c): 15 statistics<br/>window SD + textbook autocorrelation<br/>at fixed lags, medians over windows"]:::key
    LAW["law theta = (sigma_f, rho_f, sigma_s, tau_s)<br/>+ each sweep's real tilt b_hat(c, s)"]:::key
    SIMN["simulator at the cell's own layout:<br/>continuous sweeps, same processing,<br/>common random numbers"]:::neutral
    QS["q_sim(theta): Harrell-Davis medians<br/>over M = 3000 simulated windows"]:::neutral
    JJ["J(theta) = (q_sim - q_hat)^T W (q_sim - q_hat)<br/>W = inverse simulated covariance, iterated;<br/>least_squares (trf) -> theta_hat(c)"]:::pushed
    W1 --> Q
    W2 --> Q
    LAW --> SIMN --> QS
    Q --> JJ
    QS --> JJ
    JJ -. "next theta" .-> LAW
  end
  subgraph SWEEP["Per-sweep stage and the twins (planned)"]
    direction LR
    PS["Block 9: per sweep, one solve at the cell's weights;<br/>v(c, s) by a parametric bootstrap;<br/>DerSimonian-Laird per protocol, shrinkage"]:::planned
    TW["Block 5: each twin sweep carries<br/>its real sweep's law and tilt"]:::planned
    G7["Stage 7: the recovery gate"]:::planned
    PS --> TW --> G7
  end
  CELL --> SWEEP
  classDef done fill:#2d9a3d,color:#ffffff,stroke:#1f6e2b,stroke-width:1px;
  classDef tested fill:#2a9d8f,color:#ffffff,stroke:#1d6f65,stroke-width:1px;
  classDef pushed fill:#e9c46a,color:#1a1a1a,stroke:#b8963c,stroke-width:1px;
  classDef planned fill:#d62828,color:#ffffff,stroke:#9c1c1c,stroke-width:1px;
  classDef ext fill:#ffffff,color:#52514e,stroke:#8a8984,stroke-width:1px,stroke-dasharray:4 3;
  classDef neutral fill:#f4f3f0,color:#0b0b0b,stroke:#8a8984,stroke-width:1px;
  classDef key fill:#ffffff,color:#0b0b0b,stroke:#2a78d6,stroke-width:2px;
