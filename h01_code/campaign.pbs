#!/bin/bash
#PBS -N campaign
#PBS -q cpu
#PBS -J 0-0
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o logs/campaign.log
# ---------------------------------------------------------------------------
# CAMPAIGN: one submission runs the whole per-cell pipeline for every cell of
# one population (decision D-004, 2026-09-22):
#
#     P1 export  (run_p1_export.py)       aligned .hoc + tables, skeleton F
#     P2 measure (run_spine_area_F.py)    per-spine MESH areas, shard ledgers
#     P3 merge   (merge_spine_area_F.py)  phi_mesh + F, deliverable mesh_beyond
#
# The array index is decomposed over (manifest row, shard):
#
#     N = manifest rows, S = SHARDS        -J 0-(N*S-1)
#     ROW   = index / S     -> the cell (manifest row, 0-based, = P1 --task)
#     SHARD = index % S     -> the P2 shard of that cell  (= P2 --task)
#
# so P1's --task and P2's --cell are read from the SAME manifest row and
# cannot drift apart. P1 runs on shard 0 only; P2 runs on every shard; P3
# runs in the same task when S = 1 (the default), and as a dependent array
# of this same script with PHASE=merge when S > 1.
#
# Start with S = 1 (the handoff's recommendation): one task per cell, all
# three stages in it, no dependent job. P1 resumes on a fingerprint match and
# P2 resumes from its ledger every 25 spines, so a re-submission after a
# walltime kill is nearly free. Move to S > 1 only if one cell does not fit
# the walltime.
#
#   cd h01_code && mkdir -p logs
#   # S = 1, N cells (build_p1_manifest.py printed -J 0-(N-1)):
#   qsub -N camp_L3exc -o logs/camp_L3exc.log -J 0-536 \
#        -v MANIFEST=../h01/p1/manifests/L3_exc.csv campaign.pbs
#   # S = 4: the measure array, then the dependent merge array
#   qsub -N camp_L3exc -o logs/camp_L3exc.log -J 0-2147 \
#        -v MANIFEST=../h01/p1/manifests/L3_exc.csv,SHARDS=4 campaign.pbs
#   qsub -N merge_L3exc -o logs/merge_L3exc.log -J 0-536 \
#        -W depend=afterokarray:<jobid[]> \
#        -v MANIFEST=../h01/p1/manifests/L3_exc.csv,SHARDS=4,PHASE=merge campaign.pbs
#
# INTERNEURONS (D-003 x D-004): the passive tree is P1's concern only. Spine
# area is geometry and does not depend on (cm, Ra), so P2 and P3 run ONCE per
# cell into h01/out/ whichever tree P1 wrote. Submit the first variant with the
# full pipeline and the second variant as P1 only (p1_export.pbs), e.g.
#   qsub ... -v MANIFEST=../h01/p1/manifests/L2_inh.csv,PASSIVE_TABLE=passive_params_inh_SST.csv,OUT_DIR=p1_inh_SST campaign.pbs
#   qsub ... -v MANIFEST=../h01/p1/manifests/L2_inh.csv,PASSIVE_TABLE=passive_params_inh_PVVIP.csv,OUT_DIR=p1_inh_PVVIP p1_export.pbs
# Never run campaign.pbs twice for the two trees: P2 is the expensive stage
# and would measure every interneuron twice for identical numbers.
#
# Give every submission its own -N, -o and -J on the command line; with the
# defaults ten populations would append into the same logs/campaign.log.
# Submit from h01_code: #PBS -o is relative.
#
# Knobs (qsub -v): MANIFEST (required), H01_ROOT, H01_CODE, H01_ENV, and
#   SHARDS=<S>           P2 shards per cell; default 1. The -J width MUST be
#                        N*S (a task whose ROW is past the manifest refuses)
#   PHASE=all|merge      default all (P1 + P2, and P3 when SHARDS=1);
#                        merge = P3 only, index = manifest row, -J 0-(N-1)
#   PASSIVE_TABLE=<csv>  P1 only; default $H01_CODE/passive_params.csv
#   OUT_DIR=<dir>        P1 only; default $H01_ROOT/p1 (relative: under root)
#   DRY_RUN=1            P1 and P2 --dry-run; P3 is skipped (nothing to merge)
#   FORCE=1              P1 --force (reprocess a matching record)
#   NO_RIGIDITY=1        P1 --no-rigidity-control
#   NO_NEURON_VALIDATE=1 P1 --no-neuron-validate
#   SUBSET=<n>           P2 AND P3 --subset (a staged run; the merge must see
#                        the same value or its fingerprint will not match)
#   MIN_SPINE_VALUE=<v>  P2 AND P3 --min-spine-value (same reason)
#   NO_MEASURE_BASE=1    P2 AND P3 --no-measure-base (same reason; the merge
#                        then reports qc_status=fail, by design)
#   MIN_COVERAGE=<f>     P3 --min-coverage (default the merger's 0.99)
#
# What is deliberately NOT a knob: --deliverable (always mesh_beyond, D-004)
# and the merger's allow-missing switch (never passed: a dead shard must fail
# the merge, not silently bias F downward). smoke_test_hpc_runner.py C1c
# asserts the flag's text is absent from this file.
#
# Outputs, per cell: $OUT_DIR/<id>/ (P1; F_lit there is the SKELETON bracket),
# $H01_ROOT/out/cell<id>_shards/ (P2), $H01_ROOT/out/neuron_<id>_phi_mesh.csv
# and the row in $H01_ROOT/out/spine_area_F_summary.csv (P3; F_lit_deliverable
# is THE F). After the array: python3 campaign_join.py --root $H01_ROOT
#
# The bare ENV_NAME / CODE / ROOT are NOT read (reported and ignored): the
# login shell exports them for other projects and a PBS job sources .bashrc.
# ---------------------------------------------------------------------------
set -eo pipefail

# Activation block copied from run_smoke_tests.sh (2026-09-20, H01_ENV form),
# the one form verified to survive this cluster's conda hooks.
# SKIP_CONDA=1 runs the script against whatever python3 is already on PATH.
# It exists so this script can be exercised off-cluster before it is shipped;
# on the cluster, leave it unset so the env is the one the jobs will use.
if [ -z "${SKIP_CONDA:-}" ]; then
    # H01_ENV, never the bare ENV_NAME. The login shell exports ENV_NAME for
    # another project (ENV_NAME=sbi_export, observed 2026-09-20), a PBS job
    # sources .bashrc, and honouring it activated THAT env while the outcome
    # check below passed -- python3 did resolve inside envs/$ENV_NAME/. So the
    # knob is H01_ENV, and a stale ENV_NAME is reported and ignored, exactly
    # like CODE and ROOT.
    if [ -n "${ENV_NAME:-}" ]; then
        echo "NOTE: ENV_NAME is set ($ENV_NAME) and is IGNORED; the knob is H01_ENV."
    fi
    H01_ENV="${H01_ENV:-spine_env}"
    # set +e AS WELL AS set +u. `conda activate` runs the env's activate.d
    # hooks, and those can return non-zero while still having activated
    # correctly -- binutils on this cluster prints its INFO block and returns
    # 1. Under `set -e` that killed the script here, after the INFO block and
    # before any test ran: no error, no output, exit 1. Verified by
    # reproduction, 2026-09-16.
    set +u
    set +e
    eval "$(conda shell.bash hook)"
    conda activate "$H01_ENV"
    set -e
    set -u
    # So trust the OUTCOME, not the status: activation is real only if
    # python3 now resolves inside the env.
    case "$(command -v python3 || true)" in
        *"/envs/$H01_ENV/"*) ;;
        *)
            echo "ERROR: 'conda activate $H01_ENV' did not take effect."
            echo "  python3 is $(command -v python3 || echo '<none>')"
            echo "  Check the env exists:  conda env list"
            exit 1
            ;;
    esac
else
    set -u
    echo "SKIP_CONDA set -- using $(which python3) without activating an env"
fi

# H01_ROOT / H01_CODE, never the bare ROOT / CODE. Those are names a login
# shell routinely exports for another project, and a PBS job sources .bashrc,
# so the bare names would send every array task into the wrong tree. Old-style
# values are reported and ignored rather than obeyed (2026-09-19).
for _stale in ROOT CODE; do
    eval "_v=\${$_stale:-}"
    if [ -n "$_v" ]; then
        echo "NOTE: $_stale is set ($_v) and is IGNORED; the knobs are H01_ROOT / H01_CODE."
    fi
done
H01_ROOT="${H01_ROOT:-/davinci-1/home/ldellamea/TEEG/Towards-EEG/h01}"
H01_CODE="${H01_CODE:-/davinci-1/home/ldellamea/TEEG/Towards-EEG/h01_code}"
for _script in run_p1_export.py run_spine_area_F.py merge_spine_area_F.py; do
    if [ ! -f "$H01_CODE/$_script" ]; then
        echo "ERROR: H01_CODE=$H01_CODE is not h01_code (no $_script)."
        exit 1
    fi
done
if [ ! -d "$H01_ROOT/neurons" ]; then
    echo "ERROR: H01_ROOT=$H01_ROOT has no neurons/ -- wrong campaign root."
    exit 1
fi
# Checked here, before the interpreter starts, so the failure names the path
# instead of surfacing as a resolve() SystemExit deep in the log.
if [ ! -f "$H01_CODE/g_table_cyl_2deg.npz" ]; then
    echo "ERROR: calibration table missing: $H01_CODE/g_table_cyl_2deg.npz"
    echo "  It is tracked in git next to this script; git pull, or check H01_CODE."
    exit 1
fi
if [ ! -d "$H01_CODE/stage1" ]; then
    echo "ERROR: symlink farm missing: $H01_CODE/stage1 (run: bash stage1_link.sh)"
    exit 1
fi
PASSIVE_TABLE="${PASSIVE_TABLE:-$H01_CODE/passive_params.csv}"
case "$PASSIVE_TABLE" in
    /*) ;;
    *) PASSIVE_TABLE="$H01_CODE/$PASSIVE_TABLE" ;;
esac
if [ ! -f "$PASSIVE_TABLE" ]; then
    echo "ERROR: passive table missing: $PASSIVE_TABLE"
    exit 1
fi
OUT_DIR="${OUT_DIR:-$H01_ROOT/p1}"
case "$OUT_DIR" in
    /*) ;;
    *) OUT_DIR="$H01_ROOT/$OUT_DIR" ;;
esac
MANIFEST="${MANIFEST:?set MANIFEST, e.g. qsub -v MANIFEST=../h01/p1/manifests/L3_exc.csv campaign.pbs}"
MANIFEST_ARG="$MANIFEST"
case "$MANIFEST" in
    /*) ;;
    *) MANIFEST="$H01_CODE/$MANIFEST" ;;
esac
if [ ! -f "$MANIFEST" ]; then
    echo "ERROR: MANIFEST does not exist: $MANIFEST"
    exit 1
fi
SHARDS="${SHARDS:-1}"
case "$SHARDS" in
    ''|*[!0-9]*) echo "ERROR: SHARDS must be a positive integer, got '$SHARDS'"; exit 1 ;;
esac
SHARDS=$(( 10#$SHARDS ))           # 10#: never let bash read a leading zero as octal
if [ "$SHARDS" -lt 1 ]; then
    echo "ERROR: SHARDS must be a positive integer, got '$SHARDS'"; exit 1
fi
PHASE="${PHASE:-all}"
case "$PHASE" in
    all|merge) ;;
    *) echo "ERROR: PHASE must be 'all' or 'merge', got '$PHASE'"; exit 1 ;;
esac

# ---- which cell: read from the manifest, the single source of truth -------
# Column 1 must be cell_id (build_p1_manifest.py writes it first). ROW r is
# the r-th non-empty line after the header (0-based), which is how pandas
# counts rows in run_p1_export.py (skip_blank_lines). A CR is stripped in case
# the manifest ever crossed a Windows boundary.
IDX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-0}}"
case "$IDX" in
    ''|*[!0-9]*) echo "ERROR: array index '$IDX' is not an integer"; exit 1 ;;
esac
IDX=$(( 10#$IDX ))
if [ "$PHASE" = merge ]; then
    ROW="$IDX"
    SHARD=0
else
    ROW=$(( IDX / SHARDS ))
    SHARD=$(( IDX % SHARDS ))
fi
HEAD1=$(awk -F, 'NR==1 {sub(/\r$/, ""); print $1; exit}' "$MANIFEST")
if [ "$HEAD1" != "cell_id" ]; then
    echo "ERROR: MANIFEST $MANIFEST: first column is '$HEAD1', expected cell_id"
    exit 1
fi
NROWS=$(awk '{sub(/\r$/, "")} NR>1 && NF>0 {n++} END {print n+0}' "$MANIFEST")
if [ "$ROW" -ge "$NROWS" ]; then
    echo "ERROR: array index $IDX -> manifest row $ROW, but $MANIFEST has $NROWS rows."
    echo "  For SHARDS=$SHARDS the array must be -J 0-$(( NROWS * SHARDS - 1 )) (PHASE=merge: -J 0-$(( NROWS - 1 )))."
    exit 1
fi
CELL=$(awk -F, -v r="$ROW" '{sub(/\r$/, "")} NR>1 && NF>0 {if (n==r) {print $1; exit}; n++}' "$MANIFEST")
case "$CELL" in
    ''|*[!0-9]*)
        echo "ERROR: manifest row $ROW of $MANIFEST has cell_id '$CELL' (not an integer)."
        exit 1 ;;
esac

cd "$H01_CODE"
echo "host $(hostname) | manifest $(basename "$MANIFEST") | index $IDX -> row $ROW shard $SHARD/$SHARDS | cell $CELL | phase $PHASE | $(date -u +%FT%TZ)"
echo "passive $(basename "$PASSIVE_TABLE") | p1 out $OUT_DIR | p2/p3 out $H01_ROOT/out"
echo "python $(which python3)"

P1_EXTRA=""
if [ -n "${DRY_RUN:-}" ]; then P1_EXTRA="$P1_EXTRA --dry-run"; fi
if [ -n "${FORCE:-}" ]; then P1_EXTRA="$P1_EXTRA --force"; fi
if [ -n "${NO_RIGIDITY:-}" ]; then P1_EXTRA="$P1_EXTRA --no-rigidity-control"; fi
if [ -n "${NO_NEURON_VALIDATE:-}" ]; then P1_EXTRA="$P1_EXTRA --no-neuron-validate"; fi
# P2 and P3 share the fingerprint knobs: whatever the shards were built with,
# the merge must be told the same, or it refuses the shards as foreign.
FP_EXTRA=""
if [ -n "${SUBSET:-}" ]; then FP_EXTRA="$FP_EXTRA --subset $SUBSET"; fi
if [ -n "${MIN_SPINE_VALUE:-}" ]; then FP_EXTRA="$FP_EXTRA --min-spine-value $MIN_SPINE_VALUE"; fi
if [ -n "${NO_MEASURE_BASE:-}" ]; then FP_EXTRA="$FP_EXTRA --no-measure-base"; fi
P2_EXTRA="$FP_EXTRA"
if [ -n "${DRY_RUN:-}" ]; then P2_EXTRA="$P2_EXTRA --dry-run"; fi
P3_EXTRA="$FP_EXTRA"
if [ -n "${MIN_COVERAGE:-}" ]; then P3_EXTRA="$P3_EXTRA --min-coverage $MIN_COVERAGE"; fi

# ---- phase 1: P1 export, shard 0 only ---------------------------------------
if [ "$PHASE" = all ] && [ "$SHARD" -eq 0 ]; then
    echo "=== P1 export | cell $CELL | row $ROW | $(date -u +%FT%TZ)"
    _t0=$SECONDS
    if ! python3 run_p1_export.py \
            --root "$H01_ROOT" \
            --stage1-dir "$H01_CODE/stage1" \
            --passive-table "$PASSIVE_TABLE" \
            --out-dir "$OUT_DIR" \
            --manifest "$MANIFEST" \
            --task "$ROW" \
            -v \
            $P1_EXTRA; then
        echo "ERROR: P1 export failed for cell $CELL (row $ROW); P2 and P3 not run for this cell."
        echo "  Fix the cause and re-submit this index: P1 resumes on a matching record."
        exit 1
    fi
    echo "=== P1 done | cell $CELL | $(( SECONDS - _t0 )) s"
fi

# ---- phase 2: P2 measure, every shard ----------------------------------------
if [ "$PHASE" = all ]; then
    echo "=== P2 measure | cell $CELL | shard $SHARD/$SHARDS | $(date -u +%FT%TZ)"
    # Compute nodes reach the H01 bucket only through the proxy module.
    module load proxy || echo "WARNING: module load proxy failed"
    _t0=$SECONDS
    python3 run_spine_area_F.py \
        --root "$H01_ROOT" \
        --stage1-dir "$H01_CODE/stage1" \
        --g-table "$H01_CODE/g_table_cyl_2deg.npz" \
        --cell "$CELL" \
        --task "$SHARD" \
        --ntasks "$SHARDS" \
        $P2_EXTRA
    echo "=== P2 done | cell $CELL | shard $SHARD/$SHARDS | $(( SECONDS - _t0 )) s"
fi

# ---- phase 3: P3 merge -- same task when SHARDS=1, else the dependent run --
if [ "$PHASE" = merge ] || [ "$SHARDS" -eq 1 ]; then
    if [ -n "${DRY_RUN:-}" ]; then
        echo "=== P3 merge SKIPPED (DRY_RUN): no shard ledger to merge for cell $CELL"
    else
        echo "=== P3 merge | cell $CELL | ntasks $SHARDS | deliverable mesh_beyond | $(date -u +%FT%TZ)"
        _t0=$SECONDS
        python3 merge_spine_area_F.py \
            --root "$H01_ROOT" \
            --stage1-dir "$H01_CODE/stage1" \
            --g-table "$H01_CODE/g_table_cyl_2deg.npz" \
            --cell "$CELL" \
            --ntasks "$SHARDS" \
            --deliverable mesh_beyond \
            $P3_EXTRA
        echo "=== P3 done | cell $CELL | $(( SECONDS - _t0 )) s"
    fi
else
    echo "=== P3 merge deferred: SHARDS=$SHARDS > 1. After this array completes, submit"
    echo "    qsub -J 0-$(( NROWS - 1 )) -W depend=afterokarray:<this jobid> -v MANIFEST=$MANIFEST_ARG,SHARDS=$SHARDS,PHASE=merge campaign.pbs"
fi

echo "index $IDX (cell $CELL) finished $(date -u +%FT%TZ)"
